{
  "name": "playwright-xdebug",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Test fixture for driving Xdebug (DBGp) from specs.",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "import": "./core.mjs",
      "require": "./core.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "core.js",
    "core.mjs",
    "core.d.ts",
    "lib/",
    "examples/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test --config=playwright.config.js",
    "test:drupal": "playwright test --config=playwright.drupal.config.js",
    "test:compatibility": "node --test tests/live/compatibility.test.js",
    "test:stress": "node --test tests/live/stress.test.js && playwright test --config=playwright.stress.config.js",
    "test:types": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.2.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "5.9.3"
  },
  "types": "index.d.ts"
}
