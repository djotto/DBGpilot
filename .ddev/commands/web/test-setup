#!/usr/bin/env bash

## Description: Install DBGpilot's browser and compatibility test tooling.
## Usage: test-setup
## Example: "ddev test-setup"

set -euo pipefail
cd /var/www/html
export PLAYWRIGHT_BROWSERS_PATH=/mnt/ddev-global-cache/dbgpilot/playwright
npm ci
npx playwright install --with-deps chromium
node scripts/prepare_test_runtimes.mjs
