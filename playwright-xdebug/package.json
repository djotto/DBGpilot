{
  "name": "playwright-xdebug",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Test fixture for driving Xdebug (DBGp) from specs.",
  "main": "index.js",
  "exports": { ".": "./index.js", "./core": "./core.js" },
  "files": ["index.js", "core.js", "lib/", "examples/", "README.md", "LICENSE", "NOTICE.md"],
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test --config=playwright.config.js",
    "test:drupal": "playwright test --config=playwright.drupal.config.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.2.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
